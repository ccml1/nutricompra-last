# NutriCompra backend — environment variables
#
# Copy this file to `.env` (never commit `.env`) and fill in real values for
# your local/staging/production PostgreSQL instance.

# Prisma connection string. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://nutricompra:changeme@localhost:5432/nutricompra?schema=public"

# Port the NestJS HTTP server listens on.
PORT=3000
